      {
       "name": "document_url",
       "value": "={{ $json.link }}"
      },
      {
       "name": "page_size",
       "value": "A4"
      }
     ]
    }
   },
   "typeVersion": 4.2,
   "alwaysOutputData": true,
   "notes": "This httpRequest node performs automated tasks as part of the workflow."
  },
