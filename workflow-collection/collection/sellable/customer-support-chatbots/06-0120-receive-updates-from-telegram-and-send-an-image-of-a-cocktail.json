{
 "name": "Receive updates from Telegram and send an image of a cocktail",
 "nodes": [
  {
   "name": "Telegram Trigger",
   "type": "n8n-nodes-base.telegramTrigger",
   "position": [
    570,
    260
   ],
   "parameters": {
    "updates": [
     "message"
    ],
    "additionalFields": {}
   },
   "credentials": {
    "telegramApi": {
     "name": "telegram-bot"
    }
   },
   "typeVersion": 1
  },
  {
   "name": "HTTP Request",
   "type": "n8n-nodes-base.httpRequest",
   "position": [
    770,
    260
   ],
   "parameters": {
    "url": "https://www.thecocktaildb.com/api/json/v1/1/random.php",
    "options": {}
   },
   "typeVersion": 1
  },
  {
   "name": "Telegram",
   "type": "n8n-nodes-base.telegram",
   "position": [
    970,
    260
   ],
   "parameters": {
    "file": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strDrinkThumb\"]}}",
    "chatId": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"chat\"][\"id\"]}}",
    "operation": "sendPhoto",
    "additionalFields": {
     "caption": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strDrink\"]}}",
     "reply_to_message_id": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"message_id\"]}}"
    }
   },
   "credentials": {
    "telegramApi": {
     "name": "telegram-bot"
    }
   },
   "typeVersion": 1
  }
 ],
