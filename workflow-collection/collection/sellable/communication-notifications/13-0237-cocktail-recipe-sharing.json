      },
      {
       "name": "recipe",
       "text": "={{$node[\"HTTP Request\"].json[\"drinks\"][0][\"strInstructions\"]}}"
      }
     ]
    },
    "additionalFields": {
     "waitForImage": true
    }
   },
   "credentials": {
    "bannerbearApi": {
     "name": "Bannerbear"
    }
   },
   "typeVersion": 1,
   "id": "node-a1ea1d00"
  },
  {
